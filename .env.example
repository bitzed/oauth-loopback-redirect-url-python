# ── Zoom OAuth Loopback + PKCE PoC (Python) — environment defaults ─────────
# Copy to `.env` and fill in your values. Every key here has an equivalent
# command-line flag, so `.env` is entirely optional.

# Public Client ID from your Zoom Marketplace app.
# App Credentials → toggle "Use Public Client OAuth" ON → copy the Public Client ID.
# A PKCE public client does NOT use a client secret.
PUBLIC_CLIENT_ID=your_public_client_id_here

# Path portion of the loopback redirect URI. Must match what you registered
# in the OAuth Allow List (register e.g. http://127.0.0.1/callback).
REDIRECT_PATH=/callback

# Loopback host to bind & send. Use a numeric literal ONLY — never "localhost".
# 127.0.0.1 (IPv4) or ::1 (IPv6). They are matched as different hosts.
LOOPBACK_HOST=127.0.0.1

# Port for the loopback listener.
#   0    → OS-assigned ephemeral port. The real RFC 8252 flow; relies on Zoom
#          ignoring the port when matching the registered redirect URI.
#   3000 → pin the listener to a fixed port so the runtime redirect URI matches
#          a registered URI exactly. Register http://127.0.0.1:3000/callback
#          verbatim. Exact-match workaround, NOT RFC 8252.
# See "Documented vs. observed" in README.md for why both modes exist.
LOOPBACK_PORT=0

# Zoom OAuth / API endpoints (override only for special environments).
AUTHORIZE_BASE_URL=https://zoom.us/oauth/authorize
TOKEN_BASE_URL=https://zoom.us/oauth/token
API_BASE_URL=https://api.zoom.us
